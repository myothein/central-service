# Placeholder configuration only; never commit real production credentials.
PORT=3000
SYSTEM_DATABASE_URL=
CENTRAL_ALLOWED_ORIGINS=
LOG_LEVEL=info

# Keycloak/OIDC is the default Central administration identity provider.
# Use HTTPS issuer and an issuer-owned JWKS URL (same realm, same origin).
CENTRAL_ADMIN_AUTH_MODE=oidc
CENTRAL_OIDC_ISSUER=
CENTRAL_OIDC_JWKS_URL=
CENTRAL_OIDC_AUDIENCE=
CENTRAL_OIDC_REQUIRED_ROLE=CENTRAL_ADMIN

# Local QA ONLY: explicitly opt in to the temporary shared admin key.
# In production legacy is always disabled, regardless of these values.
# NODE_ENV=test
# CENTRAL_ADMIN_AUTH_MODE=legacy
# CENTRAL_ALLOW_DEV_API_KEY=true
# CENTRAL_ADMIN_API_KEY=

# JSON object mapping tenant IDs to different temporary agent credentials.
# Workload identity and credential rotation remain production release gates.
CENTRAL_AGENT_KEYS_JSON=
