{
  "name": "central-service",
  "version": "1.0.0",
  "description": "Central service for multi-tenant management",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "test:postgres": "npm run build && node --test dist/__tests__/event-postgres.integration.test.js"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.1",
    "uuid": "^13.0.0",
    "pg": "^8.16.3",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.6.2",
    "eslint": "^8.48.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "@types/pg": "^8.15.6",
    "@types/cors": "^2.8.19"
  }
}
